<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.universal_copy"> <!-- Sesuaikan package name Anda -->

    <!-- Izin untuk notifikasi (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Izin untuk bind accessibility -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />

    <application
        android:label="Universal Copy"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        
        <!-- Activity bawaan Flutter -->
        <activity android:name=".MainActivity" ... > ... </activity>

        <!-- Daftarkan Accessibility Service -->
        <service
            android:name=".CopyAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
